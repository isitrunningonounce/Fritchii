#version 450
#extension GL_GOOGLE_include_directive : require
#include "mkw_hudless_srgb.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D scene;
layout(binding = 1, rgba8) uniform writeonly image2D guest_present;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(guest_present)))) {
        return;
    }
    vec4 color = vec4(0.0);
    if (all(lessThan(pixel, textureSize(scene, 0)))) {
        vec3 linear = clamp(texelFetch(scene, pixel, 0).rgb, 0.0, 1.0);
        color = vec4(MarioKartHudlessSrgb(linear.r), MarioKartHudlessSrgb(linear.g),
                     MarioKartHudlessSrgb(linear.b), 1.0);
    }
    imageStore(guest_present, pixel, color);
}
