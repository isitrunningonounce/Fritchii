#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D guest_color;
layout(binding = 1, rgba16f) uniform writeonly image2D dlss_color;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(dlss_color)))) {
        return;
    }
    // With HDR output the guest's square-root-encoded color exceeds 1.0 (reference white).
    // NVIDIA DLSS clips LDR input there, so it takes this color as linear HDR instead.
    vec3 encoded = max(texelFetch(guest_color, pixel, 0).rgb, vec3(0.0));
    imageStore(dlss_color, pixel, vec4(encoded * encoded, 1.0));
}
